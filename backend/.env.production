# CONFIGURACIÓN PARA PRODUCCIÓN
# Este archivo se usará cuando despliegues a un servidor

# BASE DE DATOS EN LA NUBE (MongoDB Atlas)
# Reemplaza con tu URL real de MongoDB Atlas
MONGO_URI=mongodb+srv://usuario:password@cluster.mongodb.net/cosechando?retryWrites=true&w=majority

# ENTORNO
NODE_ENV=production

# SEGURIDAD
JWT_SECRET=CosechandoApp2024_SuperSecretKey_NoCompartir_ProduccionSegura_JWT

# SERVIDOR
PORT=3000

# FRONTEND (reemplaza con tu dominio real)
FRONTEND_URL_PROD=https://cosechando.netlify.app

# CONFIGURACIÓN DE CORS
ALLOWED_ORIGINS=https://cosechando.netlify.app,https://cosechando-app.vercel.app